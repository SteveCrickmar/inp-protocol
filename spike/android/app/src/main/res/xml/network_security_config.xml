<?xml version="1.0" encoding="utf-8"?>
<!--
  DISPOSABLE Phase-0 spike (OC-5). Spec §9: cleartext is a DEV-ONLY exception.

  The probe talks to the local spike Laravel server over plain HTTP. Cleartext is
  scoped to exactly the dev hosts and nothing else:
    - 10.0.2.2   : the Android emulator's alias for the host machine's loopback
                   (so http://10.0.2.2:8111 reaches `php artisan serve` on the host).
    - localhost / 127.0.0.1 : for a server reachable on the device itself
                   (e.g. via `adb reverse tcp:8111 tcp:8111`).

  Production INP shells MUST NOT ship this file — first-party traffic is HTTPS
  only (spec §9). This exists solely so the throwaway probe can hit a dev server.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
